{
  "name": "Sarves's Portfolio",
  "short-name": "Portfolio",
  "description": "Full-stack developer portfolio showcasing projects, skills, and experience",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0e27",
  "theme_color": "#667eea",
  "scope": "/",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favi.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favi.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favi.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/favi.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/favi.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "categories": ["productivity"],
  "shortcuts": [
    {
      "name": "View My Skills",
      "short_name": "Skills",
      "description": "Check out my technical skills and experience",
      "url": "/?section=skills",
      "icons": [
        {
          "src": "/favi.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "View My Projects",
      "short_name": "Projects",
      "description": "Browse my completed projects and work samples",
      "url": "/?section=projects",
      "icons": [
        {
          "src": "/favi.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Contact Me",
      "short_name": "Contact",
      "description": "Get in touch with me",
      "url": "/?section=contact",
      "icons": [
        {
          "src": "/favi.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-new", "auto"]
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
